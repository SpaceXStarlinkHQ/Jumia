{
  "installCommand": "npm install -g pnpm@10.26.1 --ignore-scripts && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/store run build",
  "outputDirectory": "artifacts/store/dist/public",
  "framework": null,
  "env": {
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
